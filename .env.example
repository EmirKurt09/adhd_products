# ── e-Kampüs (ÖBS kullanıcı adı ve şifren) ─────────────────────────────
EKAMPUS_USERNAME=
EKAMPUS_PASSWORD=

# ── Telegram ──────────────────────────────────────────────────────────
# Token: Telegram'da @BotFather → /newbot
# Chat id: bota /start yaz, sonra `python -m ekampus setup-telegram`
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ── Pushover (isteğe bağlı): sistem uyarıları buraya gider ────────────
# Çökme, takılma, hata artışı, siteye erişilememesi, giriş sorunları. Boşsa Telegram'a gider.
# Uygulama token'ı: pushover.net/apps/build · Kullanıcı anahtarı: pushover.net ana sayfası
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Son 1 saatte bu kadar hata birikirse "hata artışı" uyarısı gelir
ERROR_SPIKE_PER_HOUR=5

# ── LLM (OpenAI uyumlu) ───────────────────────────────────────────────
# deepseek → https://api.deepseek.com   |   xai (Grok) → https://api.x.ai/v1
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Boşsa sağlayıcının varsayılanı kullanılır (doctor mevcut modelleri listeler)
LLM_MODEL=
# Boşsa LLM_PROVIDER'a göre otomatik seçilir
LLM_BASE_URL=
LLM_DAILY_TOKEN_BUDGET=200000
# Sohbet hafızası: her soruda tekrar gönderilen son mesaj sayısı (0 = hafıza yok)
LLM_HISTORY_MESSAGES=20

# ── Zamanlama ─────────────────────────────────────────────────────────
TIMEZONE=Europe/Istanbul
POLL_INTERVAL_MIN=15
NIGHT_POLL_INTERVAL_MIN=60
NIGHT_HOURS=01:00-07:00
DAILY_DIGEST_TIME=08:00
REMINDER_HOURS=24,3
LIVE_LESSON_REMINDER_MIN=15

# ── Diğer ─────────────────────────────────────────────────────────────
# Boşsa: Windows → %LOCALAPPDATA%\ekampus, Docker → /data
DATA_DIR=
HEADLESS=true
